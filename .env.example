# AgentEdu local model configuration.
# Copy this file to `.env`, then fill both keys locally. Never commit `.env`.

# Both provider keys are required for real two-model routing.
# Leave either key empty to use the deterministic offline model.
AGENTEDU_MINIMAX_API_KEY=
# 国内站 Key 使用 minimaxi.com；国际站 Key 改为 https://api.minimax.io/v1
AGENTEDU_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
AGENTEDU_MODEL=MiniMax-M3

AGENTEDU_DEEPSEEK_API_KEY=
AGENTEDU_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENTEDU_MODEL_STRONG=deepseek-v4-pro

# Reliability and quota controls.
AGENTEDU_TIMEOUT=60
AGENTEDU_RETRIES=3
AGENTEDU_RPM=0
AGENTEDU_BUDGET_CALLS=0
AGENTEDU_CACHE=1

# Optional prices in CNY per million tokens, used only for local cost reporting.
AGENTEDU_PRICE_IN=0
AGENTEDU_PRICE_OUT=0
